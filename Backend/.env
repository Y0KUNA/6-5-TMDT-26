# Postgres connection (recommended to set in your environment)
# Example connection string for local Postgres created by the SQL generator
DATABASE_URL=postgresql://postgres:12345678@localhost:5433/ECommerce

# JWT secret for signing tokens (change in production)
JWT_SECRET=change_me

# Server port
PORT=3001

# Optional: frontend runtime API base URL exposed via /env.js
# Set this to the backend origin you want the frontend to call (including port)
API_BASE_URL='http://localhost:3001'
